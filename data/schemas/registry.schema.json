{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vov-365sd.local/schemas/registry.schema.json",
  "title": "Реестр типов и уровней",
  "type": "object",
  "required": [
    "event_types",
    "localization",
    "date_precision",
    "fact_status",
    "place_types",
    "place_states",
    "document_types",
    "fate_outcomes",
    "person_fact_keys",
    "evidence_basis",
    "portal_types",
    "front_accuracy",
    "front_bbox"
  ],
  "properties": {
    "event_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "place_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "place_states": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "localization": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exact",
          "settlement",
          "district",
          "approximate"
        ]
      }
    },
    "date_precision": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "day",
          "month",
          "year",
          "range"
        ]
      }
    },
    "fact_status": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "черновик",
          "выверено"
        ]
      }
    },
    "bbox": {
      "type": "object",
      "description": "Ожидаемый район координат: выход за границы считается ошибкой (ловит перепутанные широту и долготу).",
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "properties": {
        "west": {
          "type": "number"
        },
        "south": {
          "type": "number"
        },
        "east": {
          "type": "number"
        },
        "north": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "document_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "fate_outcomes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "person_fact_keys": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence_basis": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "portal_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "front_accuracy": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "front_bbox": {
      "type": "object",
      "description": "Границы театра для линий фронта: точка за ними — ошибка.",
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "properties": {
        "west": {
          "type": "number"
        },
        "south": {
          "type": "number"
        },
        "east": {
          "type": "number"
        },
        "north": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "file_roles": {
      "type": "object",
      "description": "Роли файлов источника: что именно лежит в файле.",
      "additionalProperties": {
        "type": "string",
        "minLength": 2
      }
    },
    "position_kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "position_basis": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "position_time_precision": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "movement_rates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "km_per_day"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 3
          },
          "km_per_day": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "movement_by_unit_kind": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "task_kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "task_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    },
    "task_priorities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vov-365sd.local/schemas/position.schema.json",
  "title": "Положения частей на местности",
  "description": "Наблюдённые положения формирований: кто, где, когда, по какому документу. Расчётные положения здесь запрещены.",
  "type": "object",
  "required": [
    "positions"
  ],
  "properties": {
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1941,
      "maximum": 1945,
      "description": "Год набора; обязан совпадать с именем файла."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "asOf": {
      "type": "object",
      "description": "Момент состояния: дата, время (если есть в документе) и точность.",
      "required": [
        "date",
        "precision"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Местное время из документа, без приведения к UTC."
        },
        "precision": {
          "enum": [
            "timestamp",
            "day",
            "range"
          ]
        }
      }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sheet": {
      "type": "object",
      "description": "Откуда положение: лист карты или текст документа, с оформлением.",
      "required": [
        "source_id",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src-[a-z0-9][a-z0-9-]*$"
        },
        "locator": {
          "$ref": "https://vov-365sd.local/schemas/fact.schema.json#/$defs/locator"
        },
        "colour": {
          "type": [
            "string",
            "null"
          ],
          "description": "Цвет нанесения на листе, если он что-то значит; null — нанесения не было (текст)."
        },
        "legend": {
          "type": "string",
          "description": "Расшифровка легенды листа для этой линии."
        }
      }
    },
    "position": {
      "type": "object",
      "required": [
        "id",
        "unit",
        "as_of",
        "kind",
        "label",
        "sheet",
        "basis",
        "accuracy_m",
        "status"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "geometry"
          ]
        },
        {
          "required": [
            "place"
          ],
          "description": "Геометрии нет, но пункт известен по названию."
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pos-[a-z0-9][a-z0-9-]*$"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "as_of": {
          "$ref": "#/$defs/asOf"
        },
        "kind": {
          "type": "string",
          "description": "Значение из position_kinds реестра."
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "place": {
          "type": "string",
          "pattern": "^pl-[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "description": "Дословная подпись с листа или из текста."
        },
        "sheet": {
          "$ref": "#/$defs/sheet"
        },
        "basis": {
          "type": "string",
          "description": "Значение из position_basis реестра."
        },
        "accuracy_m": {
          "type": "integer",
          "minimum": 10
        },
        "status": {
          "enum": [
            "черновик",
            "выверено"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}

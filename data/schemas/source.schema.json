{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vov-365sd.local/schemas/source.schema.json",
  "title": "Реестр исходных документов и геоисточников",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "derivative_path",
        "received"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^src-[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "archive-reply",
            "book-page",
            "presentation",
            "museum-photo",
            "map",
            "gazetteer",
            "historical-map",
            "website",
            "other",
            "archive-portal",
            "personal-letters"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "derivative_path": {
          "type": "string",
          "description": "Путь относительно корня репозитория: производная документа или журнал геокодирования.",
          "pattern": "^docs/sources/.+\\.md$"
        },
        "cache_path": {
          "type": "string",
          "description": "Каталог с сырыми ответами геосервиса, относительно корня репозитория.",
          "pattern": "^data/cache/.+$"
        },
        "received": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        },
        "snapshot_at": {
          "type": "string",
          "format": "date",
          "description": "Дата снимка сайта (для вида website)."
        },
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^src-[a-z0-9][a-z0-9-]*$"
          },
          "description": "Источники, текстом которых является этот источник (перепечатка, компиляция)."
        },
        "portal": {
          "type": "string",
          "format": "uri"
        },
        "fetched_at": {
          "type": "string",
          "format": "date"
        },
        "query": {
          "type": "object",
          "description": "Фильтры отбора на портале (часть, период, типы)."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "description": "Файлы источника: путь от корня хранилища, sha256 и роль.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3,
                "description": "Путь относительно корня Obsidian vault."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "type": "string",
                "description": "Что именно в файле: расшифровка, сканы, фотографии, справка."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "not": {
                  "enum": [
                    "gazetteer",
                    "historical-map",
                    "archive-portal"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "files"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "gazetteer",
                  "historical-map",
                  "website",
                  "archive-portal"
                ]
              }
            }
          },
          "then": {
            "required": [
              "cache_path"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "website"
              }
            }
          },
          "then": {
            "required": [
              "snapshot_at",
              "cache_path"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "archive-portal"
              }
            }
          },
          "then": {
            "required": [
              "portal",
              "fetched_at",
              "query",
              "cache_path"
            ]
          }
        }
      ]
    }
  }
}

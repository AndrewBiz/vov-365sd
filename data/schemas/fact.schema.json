{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vov-365sd.local/schemas/fact.schema.json",
  "title": "Библиотека фактов с провенансом",
  "$comment": "Не валидирует данные сама по себе: файл содержит только $defs, которые подключают схемы событий и формирований.",
  "type": "object",
  "$defs": {
    "locator": {
      "type": "object",
      "description": "Локатор внутри производной в docs/sources. Обязательно хотя бы одно поле.",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "slide": {
          "type": "integer",
          "minimum": 1
        },
        "paragraph": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 12
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "provenanceEntry": {
      "type": "object",
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src-[a-z0-9][a-z0-9-]*$"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "description": "Один источник или несколько независимых (второе требуется для статуса «выверено»).",
      "oneOf": [
        {
          "$ref": "#/$defs/provenanceEntry"
        },
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/provenanceEntry"
          }
        }
      ]
    },
    "status": {
      "enum": [
        "черновик",
        "выверено"
      ]
    },
    "single": {
      "type": "object",
      "required": [
        "value",
        "provenance",
        "status"
      ],
      "properties": {
        "value": {},
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "note": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Вид свидетельства из evidence_basis реестра; обязателен для утверждений о человеке."
        }
      },
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "description": "Конкурирующие значения одного поля. Статус выверки у конфликта не ставится.",
      "required": [
        "conflict",
        "variants"
      ],
      "properties": {
        "conflict": {
          "const": true
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/single"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "oneOf": [
        {
          "$ref": "#/$defs/single"
        },
        {
          "$ref": "#/$defs/conflict"
        }
      ]
    },
    "datePrecision": {
      "enum": [
        "day",
        "month",
        "year",
        "range"
      ]
    },
    "periodValue": {
      "type": "object",
      "required": [
        "from",
        "to",
        "precision"
      ],
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "precision": {
          "$ref": "#/$defs/datePrecision"
        }
      },
      "additionalProperties": false
    },
    "periodSingle": {
      "type": "object",
      "required": [
        "value",
        "provenance",
        "status"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/periodValue"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "note": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Вид свидетельства из evidence_basis реестра; обязателен для утверждений о человеке."
        }
      },
      "additionalProperties": false
    },
    "periodFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/periodSingle"
        },
        {
          "type": "object",
          "required": [
            "conflict",
            "variants"
          ],
          "properties": {
            "conflict": {
              "const": true
            },
            "variants": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/periodSingle"
              }
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "claim": {
      "type": "object",
      "description": "Утверждение о человеке: значение (простое или период) либо конфликт вариантов; провенанс и вид свидетельства.",
      "properties": {
        "value": {},
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "basis": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Вид свидетельства из evidence_basis реестра; обязателен для утверждений о человеке."
        },
        "note": {
          "type": "string"
        },
        "conflict": {
          "const": true
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/claimVariant"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "value",
            "status"
          ]
        },
        {
          "required": [
            "conflict",
            "variants"
          ]
        }
      ],
      "additionalProperties": false
    },
    "claimVariant": {
      "type": "object",
      "required": [
        "value",
        "status"
      ],
      "properties": {
        "value": {},
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "basis": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Вид свидетельства из evidence_basis реестра; обязателен для утверждений о человеке."
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
